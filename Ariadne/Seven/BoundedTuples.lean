import Ariadne.Core.CompositionSpec
import Mathlib.Data.List.OfFn

namespace Ariadne.Seven

/-- Positive weakly increasing tuples, generated by subtracting the first value
minus one from the tail. This enumerates combinations, rather than all functions. -/
def boundedTuples : (n M : ℕ) → List (Fin n → ℕ)
  | 0, _ => [Fin.elim0]
  | n+1, M => (List.range M).flatMap fun a =>
      (boundedTuples n (M-a)).map fun t => Fin.cons (a+1) (fun i => a+t i)

theorem mem_boundedTuples {n M : ℕ} (l : Fin n → ℕ)
    (hp : Positive l) (hs : Monotone l) (hb : ∀ i, l i ≤ M) :
    l ∈ boundedTuples n M := by
  induction n generalizing M with
  | zero =>
      have he : l = Fin.elim0 := by funext i; exact Fin.elim0 i
      simp [he, boundedTuples]
  | succ n ih =>
      let a := l 0 - 1
      let t : Fin n → ℕ := fun i => l i.succ - a
      have ha : a < M := by have := hp 0; have := hb 0; dsimp [a]; omega
      have hzero : a+1 = l 0 := by have := hp 0; dsimp [a]; omega
      have hlo (i : Fin n) : a < l i.succ := by
        have := hs (show (0 : Fin (n+1)) ≤ i.succ by exact Fin.zero_le _)
        omega
      have ht : t ∈ boundedTuples n (M-a) := by
        apply ih
        · intro i; have := hlo i; dsimp [t]; omega
        · intro i j hij
          have := hs (Fin.succ_le_succ_iff.mpr hij)
          dsimp [t]; omega
        · intro i; have := hb i.succ; dsimp [t]; omega
      apply List.mem_flatMap.mpr
      refine ⟨a, List.mem_range.mpr ha, List.mem_map.mpr ⟨t, ht, ?_⟩⟩
      funext i
      refine Fin.cases ?_ (fun j => ?_) i
      · simpa using hzero
      · have := hlo j
        simp only [Fin.cons_succ]
        dsimp [t]
        omega

end Ariadne.Seven
